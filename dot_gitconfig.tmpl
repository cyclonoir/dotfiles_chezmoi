[user]
{{- if .work }}
	email = adam.miller@newmill.com
	name = Adam Miller
{{- else }}
	email = amiller.swe@pm.me
	name = cyclonoir
{{- end }}
[fetch]
	prune = true
[push]
	default = upstream
[pull]
	rebase = true
[branch "master"]
	mergeOptions = --ff-only
[core]
{{- if eq .chezmoi.os "windows" }}
	trustctime = false
	ignorecase = true
	filemode = false
{{- end }}
	editor = nvim
	pager = delta
{{- if eq .chezmoi.os "windows" }}
	autocrlf = input
{{- end }}
[delta]
	navigate = true
	line-numbers = true
{{- /* Elsewhere delta follows BAT_THEME (ansi: the terminal's palette) and detects light or dark. */}}
{{- if eq .chezmoi.os "windows" }}
	dark = true
	syntax-theme = gruvbox-dark
{{- end }}
[alias]
	last = log -1 --stat
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --all
[merge]
	tool = diffview
[mergetool]
	prompt = false
	keepBackup = false
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[mergetool "diffview"]
	cmd = nvim --cmd \"let g:git_mergetool = 1\" -c \"DiffviewOpen -- \\\"$MERGED\\\"\"
